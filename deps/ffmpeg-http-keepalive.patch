+/* Read and drop the rest of a reply. A stalled rest is given up once a new
+ * connection is likely the faster way to the next reply. */
+static int drain(URLContext *h, uint64_t remaining)
+{
+    HTTPContext *s = h->priv_data;
+    int64_t stall = av_clip64(2 * s->max_latency, MIN_DRAIN_STALL, MAX_DRAIN_STALL);
+    int64_t deadline = av_gettime_relative() + stall;
+    uint8_t discard[4096];
+    int ret = 0;
+
+    s->hd->flags |= AVIO_FLAG_NONBLOCK;
+    while (remaining) {
+        int64_t left;
+
+        ret = ffurl_read(s->hd, discard, FFMIN(remaining, sizeof(discard)));
+        if (ret > 0) {
+            remaining -= ret;
+            s->last_read = av_gettime_relative();
+            deadline = s->last_read + stall;
+            continue;
+        }
+        if (ret != AVERROR(EAGAIN)) {
+            ret = ret ? ret : AVERROR_EOF;
+            break;
+        }
+        left = deadline - av_gettime_relative();
+        if (left <= 0) {
+            ret = AVERROR(ETIMEDOUT);
+            break;
+        }
+        if (ff_check_interrupt(&h->interrupt_callback)) {
+            ret = AVERROR_EXIT;
+            break;
+        }
+        int fd = ffurl_get_file_handle(s->hd);
+        struct pollfd p = { fd, POLLIN, 0 };
+        if (fd < 0 || poll(&p, 1, FFMAX(left / 1000, 1)) < 0)
+            av_usleep(1000);
+        ret = 0;
+    }
+    s->hd->flags &= ~AVIO_FLAG_NONBLOCK;
+    return ret;
+}

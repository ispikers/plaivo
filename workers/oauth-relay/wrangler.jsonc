{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "plaivo-oauth-relay",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	"routes": [{ "pattern": "relay.plaivo.app", "custom_domain": true }],
	"vars": { "PLAIVO_RELAY_PUBLIC_URL": "https://relay.plaivo.app" },
	"durable_objects": {
		"bindings": [{ "name": "SESSIONS", "class_name": "Sessions" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sessions"] }],
	"ratelimits": [
		{
			"name": "LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 50, "period": 60 }
		}
	]
}
